# Citadel edge API environment — TEMPLATE, no secrets.
#
# Copy to /etc/citadel/edge.env on the Pi (root:citadel, chmod 640) and edit.
# Every setting below is optional; with none of them the node runs fully
# offline-first, which is the intended default.
#
#   sudo install -d -m 750 -o root -g citadel /etc/citadel
#   sudo install -m 640 -o root -g citadel deploy/edge.env.example /etc/citadel/edge.env

# Absolute path to the SQLite database. Set this explicitly under systemd —
# see the note in citadel-edge.service.
CITADEL_DB_PATH=/home/citadel/citadel/services/edge-api/farm.db

# Real hardware mode is the default. Set this only for a clearly labelled UI
# rehearsal with synthetic seed readings; never use it for the live sensor demo.
#CITADEL_SEED_DEMO_DATA=1

# Interpreter that runs the crop-health inference CLI. Leave unset to use the
# service's own venv, which is the simplest working setup on a Pi: install
# ml/vision/requirements-pi.txt into services/edge-api/.venv and this resolves
# by itself.
#CITADEL_VISION_PYTHON=/home/citadel/citadel/services/edge-api/.venv/bin/python

# Override the crop-health model artifact. Defaults to
# ml/vision/models/crop_health_mobilenetv2_v1.1.tflite.
#CITADEL_CROP_MODEL=/home/citadel/citadel/ml/vision/models/crop_health_mobilenetv2_v1.1.tflite

# Dead-man defaults mirrored by the firmware. Seconds.
#CITADEL_MAX_RUNTIME_SEC=900
#CITADEL_ACTUATOR_FAULT_SECONDS=35

# ── Cloud sync (OFF by default) ──────────────────────────────────────────
# Leave CITADEL_CLOUD_URL unset and the background push task never starts.
# Set it only when a cloud endpoint actually exists; the node keeps working
# either way, and un-synced rows stay queued in SQLite.
#CITADEL_CLOUD_URL=http://cloud.example.internal:3002
#CITADEL_FARM_ID=farm-001
#CITADEL_SYNC_INTERVAL_SEC=10
#CITADEL_SYNC_BATCH_SIZE=50
